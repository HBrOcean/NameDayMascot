<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NameDayMascot</RootNamespace>
    <AssemblyName>NameDayMascot</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\icons\app.ico</ApplicationIcon>

    <!-- 关键：必须作为「应用清单」嵌入 exe，否则 PerMonitorV2 高 DPI 感知不生效，
         125%/150% 缩放屏上整个窗口会被系统按位图拉伸，角色发糊。
         光把 app.manifest 复制到输出目录是没用的。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 只保留中文资源卫星程序集，省掉一堆用不到的本地化 dll -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <!-- 单文件发布时把 SharpHook 的 uiohook.dll 一并打进 exe，否则运行时找不到原生库 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- CA1416: 平台兼容告警（穿透等本就是 Windows 专用）
         CS0649: 未赋值字段
         SKEXP0000: SkiaSharp 预览 API
         CS86xx: Spine/ 目录下第三方源码（spine-csharp 4.2）的可空性告警，
                 那个目录本来就不是为 nullable 写的，逐条改没意义 -->
    <NoWarn>$(NoWarn);CA1416;CS0649;SKEXP0000;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8629</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Release 不生成调试符号：publish 出来的目录更干净 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SharpHook" Version="8.0.1" />
  </ItemGroup>

  <!-- 桌宠模型资源 + 图标：随程序集输出到子目录，便于运行时按文件名定位 -->
  <ItemGroup>
    <Content Include="Assets\characters\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Spine/ 是第三方源码（spine-csharp 4.2），原本不是为 nullable 写的。
       ⚠ 这里原先写的是：
           <Compile Update="Spine\**\*.cs"><Nullable>disable</Nullable></Compile>
       —— 这个写法无效：Nullable 是项目级编译属性，不是 per-file 元数据，
       所以 Spine/ 目录仍然会产生 200+ 条 CS86xx 警告。
       真正起作用的是这两条：
         ① Spine/.editorconfig —— 按目录关闭可空性诊断（推荐，作用域精确）
         ② 上面的 NoWarn —— 兜底，防止 IDE 不读 editorconfig 时又刷屏 -->

</Project>
